import cv2
import numpy as np
import matplotlib.pyplot as plt
from urllib.request import urlopen
import requests
from io import BytesIO

def load_image(source):
    if source.startswith(('http://', 'https://')):
        try:
            response = urlopen(source)
            img_array = np.asarray(bytearray(response.read()), dtype=np.uint8)
            img = cv2.imdecode(img_array, cv2.IMREAD_COLOR)
        except Exception as e:
            print(f"Blad podczas wczytywania obrazu zdalnego: {e}")
            return None
    else:
        img = cv2.imread(source)
        if img is None:
            print(f"Nie mozna wczytac obrazu: {source}")
            return None
    
    return img

def process_image(image_path):
    print("1. Wczytywanie obrazu...")
    img = load_image(image_path)
    
    if img is None:
        print("Nie udalo sie wczytac obrazu!")
        return

    img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

    print("2. Wyswietlanie oryginalnego obrazu...")
    plt.figure(figsize=(12, 8))
    
    plt.subplot(2, 3, 1)
    plt.imshow(img_rgb)
    plt.title('Oryginalny obraz')
    plt.axis('off')

    print("3. Zmiana rozdzielczosci i konwersja do skali szarosci...")

    height, width = img.shape[:2]
    new_width = int(width * 0.5)
    new_height = int(height * 0.5)
    
    img_resized = cv2.resize(img_rgb, (new_width, new_height))
    
    img_gray = cv2.cvtColor(img_resized, cv2.COLOR_RGB2GRAY)
    
    plt.subplot(2, 3, 2)
    plt.imshow(img_gray, cmap='gray')
    plt.title('Zmniejszony + Grayscale')
    plt.axis('off')

    print("4. Obracanie obrazu o 90 stopni...")
    img_rotated = cv2.rotate(img_gray, cv2.ROTATE_90_CLOCKWISE)
    
    plt.subplot(2, 3, 3)
    plt.imshow(img_rotated, cmap='gray')
    plt.title('Obrocony o 90 stopni')
    plt.axis('off')

    print("5. Wyswietlanie obrazu wynikowego...")
    plt.subplot(2, 3, 4)
    plt.imshow(img_rotated, cmap='gray')
    plt.title('Obraz wynikowy')
    plt.axis('off')

    print("6. Wyswietlanie macierzy obrazu...")

    print(f"\nFragment macierzy obrazu (10x10 pikseli):")
    print(img_rotated[:10, :10])
    
    print(f"\nInformacje o macierzy:")
    print(f"Rozmiar: {img_rotated.shape}")
    print(f"Typ danych: {img_rotated.dtype}")
    print(f"Zakres wartosci: {img_rotated.min()} - {img_rotated.max()}")

    plt.subplot(2, 3, 5)
    plt.imshow(img_rotated[:20, :20], cmap='viridis')
    plt.title('Fragment macierzy (heatmap)')
    plt.colorbar()

    plt.subplot(2, 3, 6)
    plt.hist(img_rotated.ravel(), bins=50, alpha=0.7)
    plt.title('Histogram wartosci pikseli')
    plt.xlabel('Wartosc piksela')
    plt.ylabel('Czestosc')
    
    plt.tight_layout()
    plt.show()
    
    return img_rotated


